# ==========================================================
# GapFinder AI - Environment Configuration Template
# ==========================================================

# 1. NextAuth.js Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=gapfinder-super-secret-key-eval-2026-production

# 2. Database & Vector Store (Supabase / PostgreSQL pgvector)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
POSTGRES_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# 3. AI Layer (LLMs & Vercel AI SDK)
# Google Gemini API (Recommended - fast, high token limits)
GEMINI_API_KEY=AIzaSy...
NEXT_PUBLIC_GEMINI_API_KEY=AIzaSy...

# Optional alternative LLM providers:
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...

# 4. Deployment (Vercel)
VERCEL_ENV=production
