# ==========================================================
# GapFinder AI - Git Ignore Specification
# ==========================================================

# 1. Dependencies
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# 2. Testing & Coverage
/coverage/
*.lcov

# 3. Next.js Build Outputs
/.next/
/out/
/build/
/dist/

# 4. Local Environment & Secret Files (Never Commit Secrets)
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# 5. Debug Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 6. Operating System Artifacts
.DS_Store
Thumbs.db
Desktop.ini

# 7. IDE & Editor Configurations
.vscode/
.idea/
*.swp
*.swo

# 8. TypeScript & Vercel
*.tsbuildinfo
next-env.d.ts
.vercel/
